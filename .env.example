# Supabase Project URL (Publicly accessible frontend Supabase API URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Anonymous API Key (Publicly accessible anon key for client-side queries and auth)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (Server-side admin key for privileged database and auth operations)
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API Key (Server-side key for calling Claude API in the LLM adjustment matching layer)
ANTHROPIC_API_KEY=

# Application Base URL (Used for auth redirects, email verification links, and CORS)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated allow-list of college email domains for student verification
ALLOWED_COLLEGE_EMAIL_DOMAINS=college.edu
